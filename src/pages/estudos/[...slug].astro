---
import { getCollection } from "astro:content";
import StudyLayout from "../../components/Study/StudyLayout.astro";
import { render } from "astro:content";

export async function getStaticPaths() {
  const cases = await getCollection("studyCases");
  return cases.map((entry) => {
    const cleanSlug = entry.id.replace(/\.[^/.]+$/, "");
    return {
      params: { slug: cleanSlug },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const allCases = await getCollection("studyCases");
const cleanSlug = entry.id.replace(/\.[^/.]+$/, "");

// Formatação de data
const formattedDate = new Intl.DateTimeFormat('pt-BR', {
  dateStyle: 'long'
}).format(entry.data.publishDate);
---

<StudyLayout 
  title={entry.data.title} 
  description={entry.data.description} 
  cases={allCases}
  currentSlug={cleanSlug}
>
  <div class="flex flex-col max-w-[800px]">
    <header class="mb-12 flex flex-col gap-4 border-b border-zinc-800 pb-8">
      <a 
        href="/estudos" 
        class="inline-flex items-center gap-2 text-sm text-zinc-400 hover:text-zinc-100 transition-colors mb-4 group w-fit"
      >
        <svg class="w-4 h-4 transform transition-transform group-hover:-translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Voltar para o hub
      </a>

      <div class="flex items-center gap-2 text-sm text-zinc-500 font-medium">
        <span>{entry.data.parent || "Geral"}</span>
        <span>/</span>
        <span>{entry.data.subparent || "Tópicos"}</span>
      </div>
      
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-100">
        {entry.data.title}
      </h1>
      
      {entry.data.description && (
        <p class="text-lg text-zinc-400">
          {entry.data.description}
        </p>
      )}

      <div class="flex items-center gap-4 text-sm text-zinc-500 mt-4">
        <time dateTime={entry.data.publishDate.toISOString()}>
          {formattedDate}
        </time>
        {entry.data.role && (
          <>
            <span class="w-1 h-1 rounded-full bg-zinc-700"></span>
            <span>{entry.data.role}</span>
          </>
        )}
      </div>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none prose-p:text-zinc-300 prose-headings:text-zinc-100 prose-strong:text-zinc-100 prose-li:text-zinc-300 prose-headings:tracking-tight prose-a:text-primary hover:prose-a:text-primary/80 prose-pre:bg-[#0d1117] prose-pre:border prose-pre:border-zinc-800/50 prose-img:rounded-xl prose-img:border prose-img:border-zinc-800/50">
      <Content />
    </div>

    {entry.data.tags && entry.data.tags.length > 0 && (
      <footer class="mt-16 pt-8 border-t border-zinc-800 flex flex-wrap gap-2">
        {entry.data.tags.map(tag => (
          <a 
            href={`/estudos/tags/${tag}`}
            class="px-3 py-1 text-sm font-medium rounded-full bg-zinc-800/30 text-zinc-400 hover:bg-zinc-800 hover:text-zinc-200 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </footer>
    )}
  </div>
</StudyLayout>
