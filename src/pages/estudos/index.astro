---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const cases = await getCollection("studyCases");

const hardcodedThemes = [
  { name: "Padrões de algoritmos para entrevista", type: "developer", image: null },
  { name: "Desenvolvimento web", type: "developer", image: "/imgs/studies/desenvolvimento-web.jpeg" },
  { name: "Estrutura de dados", type: "developer", image: "/imgs/studies/estrutura-de-dados.jpeg" },
  { name: "System design", type: "developer", image: "/imgs/studies/system-design.jpeg" },
  { name: "Design system", type: "both", image: "/imgs/studies/design-system.jpeg" },
  { name: "Prototipacao", type: "designer", image: "/imgs/studies/prototipacao.jpeg" },
  { name: "UX Research", type: "designer", image: null },
  { name: "Algoritmos", type: "developer", image: null },
  { name: "Análise de requisitos", type: "developer", image: null },
];

const level0Items = hardcodedThemes.map((theme) => {
  // Find all cases that belong to this theme (case-insensitive match)
  const items = cases.filter(c => (c.data.parent || "Geral").toLowerCase() === theme.name.toLowerCase());
  
  // Sort by order
  const sorted = [...items].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
  const first = sorted[0];
  
  // If there's an article, link to it. Else, link to the theme list page as fallback.
  let href = `/estudos/temas/${theme.name}`;
  if (first) {
     const cleanSlug = first.id.replace(/\.[^/.]+$/, "");
     href = `/estudos/${cleanSlug}`;
  }

  return {
    name: theme.name,
    count: items.length,
    coverImage: theme.image,
    href,
    type: theme.type
  };
});

const getBadgeStyles = (type: string) => {
  if (type === 'developer') return 'text-developer border-developer/30 bg-developer/10';
  if (type === 'designer') return 'text-designer border-designer/30 bg-designer/10';
  if (type === 'both') return 'text-zinc-200 border-zinc-600 bg-zinc-800/80';
  return 'text-zinc-400 border-zinc-700 bg-zinc-800/80';
};

const getBadgeLabel = (type: string) => {
  if (type === 'developer') return 'Code';
  if (type === 'designer') return 'Design';
  if (type === 'both') return 'Design & Code';
  return 'Geral';
};
---

<BaseLayout title="Casos de Estudo" description="Índice de estudos e explorações técnicas.">
  <div class="w-full max-w-5xl mx-auto px-6 py-24 md:py-32">
    {/* Header */}
    <header class="mb-16 flex flex-col gap-4">
      <h1 class="text-3xl md:text-5xl font-bold tracking-tighter text-zinc-100">
        Casos de Estudos
      </h1>
      <p class="text-base md:text-lg text-zinc-400 max-w-2xl leading-relaxed">
        Um espaço dedicado à exploração contínua, documentação técnica e engenharia de requisitos.
      </p>
    </header>

    {/* Card Grid */}
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {level0Items.map((item) => (
        <a
          href={item.href}
          class="group flex flex-col gap-3 rounded-xl overflow-hidden transition-all duration-300 hover:scale-[1.02]"
        >
          {/* Thumbnail */}
          <div class="relative aspect-[4/3] w-full overflow-hidden rounded-xl border border-zinc-800/60 bg-zinc-900/40">
            {/* Category Badge Overlaid */}
            <div class="absolute top-3 left-3 z-20">
              <span class={`text-[10px] uppercase tracking-wider font-semibold px-2 py-1 rounded border backdrop-blur-md ${getBadgeStyles(item.type)}`}>
                {getBadgeLabel(item.type)}
              </span>
            </div>

            {item.coverImage ? (
              <img
                src={item.coverImage}
                alt={item.name}
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center bg-gradient-to-br from-zinc-800/60 to-zinc-900/80">
                <svg class="w-10 h-10 text-zinc-600/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                </svg>
              </div>
            )}
            {/* Subtle overlay on hover */}
            <div class="absolute inset-0 bg-gradient-to-t from-zinc-950/80 via-zinc-950/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity duration-300 z-10" />
          </div>

          {/* Label */}
          <div class="flex flex-col gap-0.5 px-1">
            <h2 class="text-sm md:text-base font-medium text-zinc-200 group-hover:text-zinc-100 transition-colors line-clamp-2 leading-snug">
              {item.name}
            </h2>
            <span class="text-xs text-zinc-500 font-medium">
              {item.count} {item.count === 1 ? "artigo" : "artigos"}
            </span>
          </div>
        </a>
      ))}
    </section>
  </div>
</BaseLayout>
