---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Portfolio3D } from "../components/Portfolio3D";
import { prepareContentCollections } from "../utils/content";

const { works, studyCases } = await prepareContentCollections();
---

<BaseLayout
  title="Henrique Negri | Product Design & Creative Engineering"
  description="Portfólio 3D cinematográfico de Henrique Negri. Arte na Interface. Engenharia no Núcleo."
  fixedLayout={true}
>
  <Portfolio3D client:load works={works} studyCases={studyCases} initialRoute="hero" />
</BaseLayout>
