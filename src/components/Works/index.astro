---
import { getCollection } from "astro:content";
import WorksList from "./WorksList";

// Fetch de ambas as coleções
const allWorks = await getCollection("works");
const allCases = await getCollection("cases");

// Order by date and take 3
const sortedWorks = allWorks.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);
const sortedCases = allCases.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime()).slice(0, 3);

const mapProject = (work: any, collectionName: string) => ({
  id: work.id,
  title: work.data.title,
  title_pt: work.data.title_pt,
  title_en: work.data.title_en,
  tags: [work.data.role],
  tags_pt: work.data.role_pt ? [work.data.role_pt] : undefined,
  tags_en: work.data.role_en ? [work.data.role_en] : undefined,
  coverImage: work.data.coverImage,
  url: `/${collectionName}/${work.id}`,
  description: work.data.description,
  description_pt: work.data.description_pt,
  description_en: work.data.description_en
});

const serializedWorks = sortedWorks.map(w => mapProject(w, "works"));
const serializedCases = sortedCases.map(w => mapProject(w, "cases"));
---

<section id="works" class="w-full relative py-32 md:py-48 bg-transparent">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12">
    
    <header class="mb-24 md:mb-32">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500 mb-4">Seleção Editorial</h2>
      <p class="text-4xl md:text-5xl lg:text-7xl font-black text-white leading-[1.1] tracking-tighter">
        Projetos com <br/>direção técnica.
      </p>
    </header>
    
    {/* Seção 1 (Trabalhos Comerciais) */}
    <div class="mb-32 md:mb-48">
      <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tighter mb-12">Em Produção</h2>
      <WorksList client:visible projects={serializedWorks} />
    </div>

    {/* Seção 2 (Casos de Estudo) */}
    <div>
      <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tighter mb-12">Laboratório & Casos</h2>
      <WorksList client:visible projects={serializedCases} />
    </div>
    
  </div>
</section>
