---
import { getCollection } from "astro:content";
import WorksList from "./WorksList";

const allWorks = await getCollection("works");

// Order defined in DESIGN_DIRECTION.md — prefer editorial priority over recency.
const priorityOrder = [
  "henrique-portifolio",
  "luzamor",
];

// Build an ordered list: first items in priorityOrder (if present), then the rest.
const ordered = [];
const remaining = [...allWorks];

for (const id of priorityOrder) {
  const idx = remaining.findIndex((w) => w.id === id);
  if (idx !== -1) {
    ordered.push(remaining.splice(idx, 1)[0]);
  }
}

// Append any remaining works (maintain original order by publishDate as fallback)
remaining.sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());
const featuredWorks = ordered.concat(remaining).slice(0, 3);

// Mapeamento dos dados do Astro para um formato serializável para o componente React
const serializedProjects = featuredWorks.map((work) => ({
  id: work.id,
  title: work.data.title,
  tags: [work.data.role], // Utilizando o papel (role) como tag principal
  coverImage: work.data.coverImage,
  slug: work.id,
  description: work.data.description
}));
---

<section id="works" class="w-full relative py-32 md:py-48 bg-transparent">
  <div class="max-w-[1440px] mx-auto px-6 md:px-12">
    
    <header class="mb-24 md:mb-32">
      <h2 class="text-xs font-bold uppercase tracking-widest text-zinc-500 mb-4">Seleção Editorial</h2>
      <p class="text-4xl md:text-5xl lg:text-7xl font-black text-white leading-[1.1] tracking-tighter">
        Projetos com <br/>direção técnica.
      </p>
    </header>
    
    {/* Montagem do palco interativo (Client Side React) */}
    <WorksList client:visible projects={serializedProjects} />
    
  </div>
</section>
