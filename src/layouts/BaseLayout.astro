---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import { AmbientBackground } from "../components/AmbientBackground";
import { SmoothScroll } from "../components/SmoothScroll";
import { CustomCursor } from "../components/CustomCursor";

interface Props {
    title: string;
    description?: string;
    canonical?: string;
    fixedLayout?: boolean;
    ogImage?: string;
    ogType?: string;
}

const {
    title,
    description = "Portfólio 3D Imersivo | Henrique Negri — Product Design & Creative Engineering.",
    canonical,
    fixedLayout = false,
    ogImage,
    ogType = "website",
} = Astro.props;

const pageTitle = `${title} | Henrique Negri`;
const pageUrl = canonical ?? Astro.url?.href;

const siteBase = Astro.site ? Astro.site.toString().replace(/\/$/, '') : (Astro.url ? Astro.url.origin : '');
const ogImageUrl = ogImage
  ? (ogImage.startsWith('http') ? ogImage : `${siteBase}${ogImage.startsWith('/') ? '' : '/'}${ogImage}`)
  : undefined;
---

<html lang="pt-BR" class="dark">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        />
        <meta name="description" content={description} />
        <meta name="robots" content="index,follow" />
        
        <!-- OpenGraph (SEO Tarefa 3) -->
        <meta property="og:type" content={ogType} />
        <meta property="og:locale" content="pt_BR" />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        {pageUrl && <meta property="og:url" content={pageUrl} />}
        {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

        <!-- Twitter Card -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}

        <!-- Mermaid.js Engine (Tarefa 2) -->
        <script is:inline src="/scripts/mermaid.min.js"></script>


        {pageUrl && <link rel="canonical" href={pageUrl} />}
        <title>{pageTitle}</title>
    </head>
    <body
        class:list={[
            "bg-[oklch(13%_0.014_250)] text-[oklch(96%_0.008_250)] font-sans antialiased selection:bg-[oklch(78%_0.16_195/0.25)] selection:text-[oklch(98%_0.01_250)]",
            fixedLayout ? "w-screen min-h-screen overflow-x-hidden relative" : "min-h-screen flex flex-col items-center"
        ]}
    >
        <a
            href="#main-content"
            class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-[oklch(20%_0.02_250)] focus:text-[oklch(96%_0.01_250)] focus:rounded focus:outline focus:outline-2 focus:outline-[oklch(82%_0.2_195)] min-h-[44px] min-w-[44px] flex items-center justify-center"
        >
            Pular para o conteúdo principal
        </a>
        <SmoothScroll client:load />
        <CustomCursor client:load />
        {!fixedLayout && <AmbientBackground client:load />}
        <main id="main-content" class={fixedLayout ? "w-full" : "flex min-h-screen w-full flex-col items-center"}>
            <slot />
        </main>
    </body>
</html>
